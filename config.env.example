# ==============================================================================
# Qwen3.8-27B FastMTP Yapılandırma Dosyası
# ==============================================================================
# Bu dosyayı 'config.env' olarak kopyalayıp özelleştirebilirsiniz:
# cp config.env.example config.env
# ==============================================================================

# Dizin Yapılandırması
WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"
LLAMA_DIR="${LLAMA_DIR:-$WORKSPACE_DIR/llama.cpp}"
MODELS_DIR="${MODELS_DIR:-$WORKSPACE_DIR/models/qwen38}"

# Hugging Face Model & Patch Bilgileri
HF_REPO="HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF"
HF_REVISION="${HF_REVISION:-993a5971fda8f30dd1b7eb2654792ba4415c7460}"
PATCH_URL="${PATCH_URL:-https://huggingface.co/HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF/resolve/${HF_REVISION}/HauhauCS-FastMTP-llama.cpp.patch}"
PATCH_SHA256="${PATCH_SHA256:-981285400b59dc45cf99936b6ff66d4b3aa0f1b532f85fa51418cb407e51d615}"
# FastMTP yamasıyla uyumlu llama.cpp taban commit'i; sürpriz upstream değişikliklerini önler.
LLAMA_CPP_COMMIT="${LLAMA_CPP_COMMIT:-4df29be4f4c3673f428170fda944a5b19f743bb8}"
MODEL_FILE="Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q8_K_P.gguf"
DRAFT_MODEL_FILE="Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-FastMTP-32K.gguf"
MODEL_SHA256="${MODEL_SHA256:-4e7735df4d1e2ec721f2551f531b815702a2f89123238c564797eda4b0304bc2}"
DRAFT_MODEL_SHA256="${DRAFT_MODEL_SHA256:-115e618e1f73cb50817ed5856f0551c6bf9c3d94df96f440eaca78dc63b8968b}"
MODEL_NAME="${MODEL_NAME:-qwen3.8}"

# llama-server Ağ ve Port Ayarları
# Tunnel kullanıldığı için varsayılan olarak yalnızca yerel arayüz dinlenir.
# Doğrudan IP:port erişimi gerekiyorsa HOST="0.0.0.0" yapabilirsiniz.
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8081}"

# API Kimlik Doğrulama
# Kullanıcıdan key istenmez; ilk başlatmada rastgele bir key üretilir.
API_KEY_FILE="${API_KEY_FILE:-$WORKSPACE_DIR/llama-api.key}"

# Model ve Çıkarım (Inference) Parametreleri
CTX_SIZE="${CTX_SIZE:-262144}"
N_GPU_LAYERS="${N_GPU_LAYERS:-999}"
SPEC_TYPE="${SPEC_TYPE:-draft-mtp}"
SPEC_DRAFT_N_MAX="${SPEC_DRAFT_N_MAX:-3}"
SPEC_DRAFT_NGL="${SPEC_DRAFT_NGL:-999}"
BATCH_SIZE="${BATCH_SIZE:-2048}"
UBATCH_SIZE="${UBATCH_SIZE:-512}"
PARALLEL="${PARALLEL:-1}"
SPLIT_MODE="${SPLIT_MODE:-none}"
FLASH_ATTN="${FLASH_ATTN:-on}"
REASONING="${REASONING:-on}"
JINJA="${JINJA:-true}"

# Log ve Süreç (PID) Dosyaları
LOG_FILE="${LOG_FILE:-$WORKSPACE_DIR/qwen.log}"
PID_FILE="${PID_FILE:-$WORKSPACE_DIR/llama-server.pid}"
